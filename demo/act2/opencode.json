{
  "$schema": "https://opencode.ai/config.json",
  "tools": {
    "write": false,
    "edit": false,
    "patch": false,
    "bash": false,
    "webfetch": false,
    "task": false
  },
  "provider": {
    "kong": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Kong AI Gateway (Skyflow-protected)",
      "options": {
        "baseURL": "{env:KONG_AI_BASE_URL}",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-4o-mini": {
          "name": "gpt-4o-mini (via Kong + Skyflow)",
          "limit": { "context": 128000, "output": 16384 }
        }
      }
    }
  }
}
