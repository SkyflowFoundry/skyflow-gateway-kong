# Copy to `.env` and fill in from Konnect:
#   Gateway Manager > (your control plane) > Data plane nodes > "New data plane node"
# Konnect shows a docker run command containing these endpoints; copy them here.
# (.env and certs/*.crt|*.key are gitignored — never commit them.)

# e.g. abc123.us.cp0.konghq.com:443  (note the :443)
KONNECT_CONTROL_PLANE_ENDPOINT=REPLACE_ME.REGION.cp0.konghq.com:443
KONNECT_CONTROL_PLANE_SERVER_NAME=REPLACE_ME.REGION.cp0.konghq.com

# e.g. abc123.us.tp0.konghq.com:443
KONNECT_TELEMETRY_ENDPOINT=REPLACE_ME.REGION.tp0.konghq.com:443
KONNECT_TELEMETRY_SERVER_NAME=REPLACE_ME.REGION.tp0.konghq.com

# DP image; match the version Konnect recommends for your control plane.
KONG_GATEWAY_IMAGE=kong/kong-gateway:3.11
