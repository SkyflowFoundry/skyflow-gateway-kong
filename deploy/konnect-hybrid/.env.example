# Copy to `.env` and fill in from Konnect:
#   Gateway Manager > (your control plane) > Data plane nodes > "New data plane node"
# Konnect shows a docker run command containing these endpoints; copy them here.
# (.env and certs/*.crt|*.key are gitignored — never commit them.)

# Copy these from the KONG_CLUSTER_* values in Konnect's "new data plane node"
# docker command. e.g. 7cd504c199.us.cp.konghq.com:443  (note the :443)
KONNECT_CONTROL_PLANE_ENDPOINT=REPLACE_ME.us.cp.konghq.com:443
KONNECT_CONTROL_PLANE_SERVER_NAME=REPLACE_ME.us.cp.konghq.com

KONNECT_TELEMETRY_ENDPOINT=REPLACE_ME.us.tp.konghq.com:443
KONNECT_TELEMETRY_SERVER_NAME=REPLACE_ME.us.tp.konghq.com

# DP image; match the version Konnect recommends for your control plane.
KONG_GATEWAY_IMAGE=kong/kong-gateway:3.14

# Must match the control plane's router flavor (Konnect 3.14 defaults to expressions).
KONG_ROUTER_FLAVOR=expressions

# Host ports for the proxy. Change these if 8000/8443 are already in use on
# your machine (e.g. PROXY_HTTP_PORT=18000), then use that port in the demo curl.
PROXY_HTTP_PORT=8000
PROXY_HTTPS_PORT=8443
